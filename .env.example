# ─── Your instance's address ────────────────────────────
# The address people type to reach Mura, for example https://mura.example.org.
# The links in the e-mails (reset password, invitations, notifications) point
# here, and it is the only origin the API answers from a browser. Left empty,
# it is http://localhost on FRONTEND_PORT, which only suits a trial on your
# own machine.
MURA_URL=

# ─── Database ───────────────────────────────────────────
POSTGRES_DB=mura
POSTGRES_USER=mura
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mura
SPRING_DATASOURCE_USERNAME=mura
SPRING_DATASOURCE_PASSWORD=changeme

# The key that signs every sign-in. Whoever knows it can sign in as anyone,
# so each instance needs its own: the backend refuses to start without one,
# or on a value shorter than 32 characters. Generate it with
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

BACKEND_PORT=8080

# Leave empty on a real instance. "dev" is for working on Mura itself: it
# keeps the demo accounts (alice, bob and admin, password "password123"),
# opens the API documentation at /swagger-ui.html and logs in detail.
# Never set it on an instance other people use.
SPRING_PROFILES_ACTIVE=

# ─── Frontend ───────────────────────────────────────────
# The pages reach the API at /api on their own address, which nginx
# forwards to the backend. Set this only to use an API served elsewhere.
VITE_API_URL=
FRONTEND_PORT=5173

# ─── Your instance, for its legal pages ─────────────────
# Mura is installed by the people who use it: whoever runs an instance for
# other people is its publisher, and French law (LCEN art. 6-III, RGPD
# art. 13) asks them to say who they are, how to reach them and who hosts
# the service. Fill these in before opening your instance to others; for a
# private install on your own machine they can stay empty.
# They are read when the frontend image is built: rebuild it after a change
# (docker compose up -d --build frontend).
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_PUBLISHER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_HOST_NAME=
VITE_LEGAL_HOST_ADDRESS=
VITE_LEGAL_HOST_PHONE=
# Where people write about their personal data. Defaults to the contact
# address above.
VITE_LEGAL_PRIVACY_CONTACT=
