# ─── Database ───────────────────────────────────────────
POSTGRES_DB=mura
POSTGRES_USER=mura
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mura
SPRING_DATASOURCE_USERNAME=mura
SPRING_DATASOURCE_PASSWORD=changeme

JWT_SECRET=change-this-to-a-very-long-random-secret-key
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173

BACKEND_PORT=8080

# ─── Frontend ───────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
FRONTEND_PORT=5173

# ─── Your instance, for its legal pages ─────────────────
# Mura is installed by the people who use it: whoever runs an instance for
# other people is its publisher, and French law (LCEN art. 6-III, RGPD
# art. 13) asks them to say who they are, how to reach them and who hosts
# the service. Fill these in before opening your instance to others; for a
# private install on your own machine they can stay empty.
# They are read when the frontend image is built: rebuild it after a change
# (docker compose up -d --build frontend).
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_PUBLISHER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_HOST_NAME=
VITE_LEGAL_HOST_ADDRESS=
VITE_LEGAL_HOST_PHONE=
# Where people write about their personal data. Defaults to the contact
# address above.
VITE_LEGAL_PRIVACY_CONTACT=
