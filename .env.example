# ─── Your instance's address ────────────────────────────
# The address people type to reach Mura, for example https://mura.example.org.
# The links in the e-mails (reset password, invitations, notifications) point
# here, and it is the only origin the API answers from a browser. Left empty,
# it is http://localhost on FRONTEND_PORT, which only suits a trial on your
# own machine. An instance other people use needs HTTPS: docs/https.md
# explains how, with the Caddy setup in docker-compose.https.yml.
MURA_URL=

# Your own address. A new instance has no account at all: the account
# created with this address becomes the administrator as soon as the code
# mailed to it is entered, and only while the instance has no administrator.
# Afterwards, administrators are named from the Administration page.
MURA_ADMIN_EMAIL=

# ─── Mail ───────────────────────────────────────────────
# Sign-up needs a code sent by e-mail, and a forgotten password a link: an
# instance without a mail server cannot let anyone in. Fill these with the
# SMTP settings of your mail provider; the usual combinations are
#   MAIL_PORT=587 with MAIL_STARTTLS=true (most providers)
#   MAIL_PORT=465 with MAIL_SSL=true
# The backend says in its log at startup whether it reached the server
# (docker compose logs backend).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=
MAIL_SSL=
# The sender people see. Most providers only accept an address of a domain
# they send for, for example Mura <mura@example.org>.
MURA_MAIL_FROM=

# ─── Database ───────────────────────────────────────────
POSTGRES_DB=mura
POSTGRES_USER=mura
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mura
SPRING_DATASOURCE_USERNAME=mura
SPRING_DATASOURCE_PASSWORD=changeme

# The key that signs every sign-in. Whoever knows it can sign in as anyone,
# so each instance needs its own: the backend refuses to start without one,
# or on a value shorter than 32 characters. Generate it with
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

BACKEND_PORT=8080

# Leave both empty on a real instance. "dev" is for working on Mura itself.
# In the backend, it keeps the demo accounts (alice, bob and admin, password
# "password123"), opens the API documentation at /swagger-ui.html and logs
# in detail. In compose, it starts Mailpit, which catches every mail and
# shows it at http://localhost:8025; leave the MAIL_ settings empty then,
# and the backend sends there.
# Never set them on an instance other people use.
SPRING_PROFILES_ACTIVE=
COMPOSE_PROFILES=

# ─── Frontend ───────────────────────────────────────────
# The pages reach the API at /api on their own address, which nginx
# forwards to the backend. Set this only to use an API served elsewhere.
VITE_API_URL=
FRONTEND_PORT=5173

# ─── Your instance, for its legal pages ─────────────────
# Mura is installed by the people who use it: whoever runs an instance for
# other people is its publisher, and French law (LCEN art. 6-III, RGPD
# art. 13) asks them to say who they are, how to reach them and who hosts
# the service. Fill these in before opening your instance to others; for a
# private install on your own machine they can stay empty.
# They are read when the frontend image is built: rebuild it after a change
# (docker compose up -d --build frontend).
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_PUBLISHER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_HOST_NAME=
VITE_LEGAL_HOST_ADDRESS=
VITE_LEGAL_HOST_PHONE=
# Where people write about their personal data. Defaults to the contact
# address above.
VITE_LEGAL_PRIVACY_CONTACT=
