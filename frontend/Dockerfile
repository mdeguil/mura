# ── Build stage ──────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
# Who runs this instance, for the legal pages. Empty unless the operator
# sets them; see frontend/src/legal/legalInfo.ts.
ARG VITE_LEGAL_PUBLISHER_NAME=""
ARG VITE_LEGAL_PUBLISHER_ADDRESS=""
ARG VITE_LEGAL_CONTACT_EMAIL=""
ARG VITE_LEGAL_PUBLICATION_DIRECTOR=""
ARG VITE_LEGAL_HOST_NAME=""
ARG VITE_LEGAL_HOST_ADDRESS=""
ARG VITE_LEGAL_HOST_PHONE=""
ARG VITE_LEGAL_PRIVACY_CONTACT=""
ENV VITE_LEGAL_PUBLISHER_NAME=$VITE_LEGAL_PUBLISHER_NAME \
    VITE_LEGAL_PUBLISHER_ADDRESS=$VITE_LEGAL_PUBLISHER_ADDRESS \
    VITE_LEGAL_CONTACT_EMAIL=$VITE_LEGAL_CONTACT_EMAIL \
    VITE_LEGAL_PUBLICATION_DIRECTOR=$VITE_LEGAL_PUBLICATION_DIRECTOR \
    VITE_LEGAL_HOST_NAME=$VITE_LEGAL_HOST_NAME \
    VITE_LEGAL_HOST_ADDRESS=$VITE_LEGAL_HOST_ADDRESS \
    VITE_LEGAL_HOST_PHONE=$VITE_LEGAL_HOST_PHONE \
    VITE_LEGAL_PRIVACY_CONTACT=$VITE_LEGAL_PRIVACY_CONTACT
RUN npm run build

# ── Runtime stage (nginx) ─────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
